# CINEGO - Git Ignore Rules

# File cấu hình nhạy cảm (Secret Keys & Passwords)
config.secret.php
.env

# Thư mục vé và uploads phát sinh trong quá trình chạy
/sent-emails/*.html
!/sent-emails/.gitkeep
/assets/uploads/*
!/assets/uploads/.gitkeep

# IDE & Hệ điều hành
.idea/
.vscode/
Thumbs.db
Desktop.ini
.DS_Store
